{
  "version": "3.0",
  "defaultProvider": "cdnjs",
  "libraries": [
    {
      "library": "jqgrid@4.6.0",
      "destination": "wwwroot/lib/jqgrid/",
      "files": [
        "js/jquery.jqGrid.min.js",
        "css/ui.jqgrid.css",
        "js/i18n/grid.locale-es.js"
      ]
    },
    {
      "library": "bootstrap@5.3.3",
      "destination": "wwwroot/lib/bootstrap/",
      "provider": "unpkg",
      "files": [
        "dist/css/bootstrap.min.css",
        "dist/js/bootstrap.bundle.min.js"
      ]
    },
    {
      "library": "jquery@3.7.1",
      "destination": "wwwroot/lib/jquery/",
      "provider": "unpkg",
      "files": [
        "dist/jquery.min.js"
      ]
    },
    {
      "library": "jquery-validation@1.21.0",
      "destination": "wwwroot/lib/jquery-validation/",
      "provider": "unpkg",
      "files": [
        "dist/jquery.validate.min.js"
      ]
    },
    {
      "library": "jquery-validation-unobtrusive@4.0.0",
      "destination": "wwwroot/lib/jquery-validation-unobtrusive/",
      "provider": "unpkg",
      "files": [
        "dist/jquery.validate.unobtrusive.min.js"
      ]
    },
    {
      "library": "jqueryui@1.13.2",
      "destination": "wwwroot/lib/jqueryui/",
      "files": [
        "jquery-ui.min.js",
        "themes/base/jquery-ui.min.css",
        "themes/base/images/ui-icons_444444_256x240.png",
        "themes/base/images/ui-icons_555555_256x240.png",
        "themes/base/images/ui-icons_777620_256x240.png",
        "themes/base/images/ui-icons_777777_256x240.png",
        "themes/base/images/ui-icons_cc0000_256x240.png",
        "themes/base/images/ui-icons_ffffff_256x240.png"
      ]
    }
  ]
}