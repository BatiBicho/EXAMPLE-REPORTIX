<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Trade24</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/trade24Styles.css" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="bg-light min-vh-100">

    <div class="container-fluid p-0 min-vh-100">
        <div class="row g-0 min-vh-100">

            <!-- Mitad Izquierda (50%): Marca Trade24 y Logo -->
            <div class="col-lg-6 bg-primary text-white p-5 d-none d-lg-flex flex-column justify-content-between">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-diagram-3 fs-3"></i>
                    <span class="fw-bold fs-5">SAMSUNG <span class="fw-light opacity-75">Mexicana</span></span>
                </div>

                <div class="my-auto py-5">
                    <h1 class="display-4 fw-bold mb-2">Trade24</h1>
                    
                </div>

                <div class="small opacity-50">
                    &copy; @DateTime.Now.Year Samsung Mexicana, S.A. de C.V. · Trade24
                </div>
            </div>

            <!-- Mitad Derecha (50%): Vista del Login -->
            <div class="col-12 col-lg-6 bg-white d-flex flex-column justify-content-between p-4 p-lg-5 min-vh-100">
                @RenderBody()
            </div>

        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>