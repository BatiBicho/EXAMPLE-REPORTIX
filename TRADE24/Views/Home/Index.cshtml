@{
    ViewData["Modulo"] = "Inicio";
    ViewData["Title"] = "Panel de control";
}

<div class="d-flex flex-column gap-4">

    <!-- Tarjetas de Métricas Resumen -->
    <div class="row g-3">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-semibold">Inventario Activo</span>
                        <h3 class="fw-bold mb-0 mt-1">128,540 <small class="fs-6 text-muted fw-normal">pzas</small></h3>
                        <span class="badge bg-success-subtle text-success mt-2">
                            <i class="bi bi-arrow-up-short"></i> 3.2% vs mes anterior
                        </span>
                    </div>
                    <div class="bg-primary bg-opacity-10 text-primary p-3 rounded-circle">
                        <i class="bi bi-box-seam fs-3"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-semibold">Entradas del Mes</span>
                        <h3 class="fw-bold mb-0 mt-1">42 <small class="fs-6 text-muted fw-normal">pedimentos</small></h3>
                        <span class="text-muted small mt-2 d-block">18 fracciones distintas</span>
                    </div>
                    <div class="bg-info bg-opacity-10 text-info p-3 rounded-circle">
                        <i class="bi bi-box-arrow-in-down fs-3"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-semibold">Salidas del Mes</span>
                        <h3 class="fw-bold mb-0 mt-1">37 <small class="fs-6 text-muted fw-normal">pedimentos</small></h3>
                        <span class="text-muted small mt-2 d-block">Retorno IMMEX</span>
                    </div>
                    <div class="bg-warning bg-opacity-10 text-warning p-3 rounded-circle">
                        <i class="bi bi-box-arrow-up fs-3"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-semibold">Cumplimiento Anexo 24</span>
                        <h3 class="fw-bold mb-0 mt-1">98.6%</h3>
                        <span class="badge bg-success-subtle text-success mt-2">Al corriente ante SAT</span>
                    </div>
                    <div class="bg-success bg-opacity-10 text-success p-3 rounded-circle">
                        <i class="bi bi-shield-check fs-3"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Sección de Acciones Rápidas (Subida de Archivos y Tareas) -->
    <div class="row g-4">

        <!-- Carga de Archivos / Data Upload -->
        <div class="col-12 col-lg-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-0 pt-3 pb-0">
                    <h5 class="fw-bold mb-0"><i class="bi bi-cloud-upload me-2 text-primary"></i>Carga de Archivos</h5>
                    <small class="text-muted">Importación masiva de pedimentos o facturas</small>
                </div>
                <div class="card-body">
                    <form>
                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Tipo de Layout</label>
                            <select class="form-select">
                                <option selected>Selecciona una opción...</option>
                                <option value="1">Pedimentos de Importación (.xml)</option>
                                <option value="2">Facturas de Exportación (.xlsx)</option>
                                <option value="3">Estructura de Materiales BOM (.csv)</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Archivo adjunto</label>
                            <input class="form-control" type="file" id="formFile">
                        </div>
                        <div class="d-flex justify-content-end gap-2">
                            <button type="reset" class="btn btn-light">Limpiar</button>
                            <button type="button" class="btn btn-primary"><i class="bi bi-upload me-1"></i> Procesar Archivo</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Ejecución de Tareas del Sistema -->
        <div class="col-12 col-lg-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-0 pt-3 pb-0">
                    <h5 class="fw-bold mb-0"><i class="bi bi-gear-wide-connected me-2 text-primary"></i>Ejecución de Procesos</h5>
                    <small class="text-muted">Tareas programadas y cálculos de saldos</small>
                </div>
                <div class="card-body d-flex flex-column justify-content-between">
                    <div class="list-group list-group-flush">
                        <div class="list-group-item border-0 d-flex justify-content-between align-items-center px-0">
                            <div>
                                <div class="fw-semibold">Cierre y Descargo Temporal</div>
                                <small class="text-muted">Calcula automáticamente descargos FIFO</small>
                            </div>
                            <button class="btn btn-outline-primary btn-sm">Ejecutar</button>
                        </div>
                        <div class="list-group-item border-0 d-flex justify-content-between align-items-center px-0">
                            <div>
                                <div class="fw-semibold">Sincronizar Tipos de Cambio</div>
                                <small class="text-muted">Actualización diaria desde BANXICO</small>
                            </div>
                            <button class="btn btn-outline-primary btn-sm">Ejecutar</button>
                        </div>
                        <div class="list-group-item border-0 d-flex justify-content-between align-items-center px-0">
                            <div>
                                <div class="fw-semibold">Verificación de Fracciones</div>
                                <small class="text-muted">Valida cambios en la TIGIE vigente</small>
                            </div>
                            <button class="btn btn-outline-primary btn-sm">Ejecutar</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- Tabla Extensa de Reportes y Registros (Fuerza Scroll Vertical) -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-0 pt-3 pb-2 d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2">
            <div>
                <h5 class="fw-bold mb-0"><i class="bi bi-file-earmark-bar-graph me-2 text-primary"></i>Bitácora de Operaciones y Reportes</h5>
                <small class="text-muted">Mostrando los últimos registros generados en la plataforma</small>
            </div>
            <button class="btn btn-sm btn-outline-secondary"><i class="bi bi-download me-1"></i> Exportar a Excel</button>
        </div>

