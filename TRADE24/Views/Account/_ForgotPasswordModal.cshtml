<!-- Modal para Restablecer Contraseña -->
<div class="modal fade" id="forgotPasswordModal" tabindex="-1" aria-labelledby="forgotPasswordModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header bg-light border-0 py-3 px-4">
                <div class="d-flex align-items-center gap-3">
                    <div class="d-inline-flex align-items-center justify-content-center bg-primary text-white rounded-circle p-2 lh-1">
                        <i class="bi bi-key-fill fs-5"></i>
                    </div>
                    <div>
                        <h5 class="modal-title fw-bold text-dark mb-0" id="forgotPasswordModalLabel">Restablecer Contraseña</h5>
                        <small class="text-muted">Trade24 · Recuperación de cuenta</small>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>

            <div class="modal-body p-4">
                <div class="alert alert-info d-flex align-items-start gap-2 border-0 bg-light mb-4" role="alert">
                    <i class="bi bi-info-circle-fill text-primary fs-5 mt-1"></i>
                    <div class="small text-secondary">
                        Ingresa tu <strong>ID de Usuario</strong>. Te llegará un correo electrónico a tu cuenta registrada con las instrucciones y el enlace para restablecer tu contraseña.
                    </div>
                </div>

                <div id="forgotAlert" class="alert alert-danger d-none py-2 small" role="alert"></div>
                <div id="forgotSuccess" class="alert alert-success d-none py-2 small" role="alert"></div>

                <form id="formForgotPassword" onsubmit="return false;">
                    <div class="mb-3">
                        <label for="txtForgotUserId" class="form-label small fw-semibold text-secondary">ID de Usuario</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted border-end-0">
                                <i class="bi bi-person-badge fs-5"></i>
                            </span>
                            <input type="text" class="form-control form-control-lg fs-6 border-start-0 ps-0" id="txtForgotUserId" placeholder="Ej. DRUIZ o número de usuario" autocomplete="username">
                        </div>
                    </div>
                </form>
            </div>

            <div class="modal-footer bg-light border-0 py-3 px-4 d-flex justify-content-between">
                <button type="button" class="btn btn-outline-secondary px-4 fw-semibold" data-bs-dismiss="modal">
                    Cancelar
                </button>
                <button type="button" id="btnSendForgot" class="btn btn-primary px-4 fw-semibold">
                    <span id="btnForgotSpinner" class="spinner-border spinner-border-sm me-2 d-none" role="status"></span>
                    Enviar correo
                </button>
            </div>
        </div>
    </div>
</div>

