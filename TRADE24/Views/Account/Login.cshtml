@using Resources = TRADE24.Resources;
@{
    ViewData["Title"] = "Iniciar Sesión";
    Layout = "_LayoutLogin";
}

<!-- Encabezado superior derecho -->
<div class="d-flex justify-content-between align-items-center w-100 mb-4">
    <!-- Logotipo visible solo en móvil cuando el panel izquierdo se oculta -->
    <div class="d-flex align-items-center gap-2 d-lg-none">
        <i class="bi bi-diagram-3 fs-3 text-primary"></i>
        <span class="fw-bold fs-5 text-dark">Trade24</span>
    </div>
    <div class="ms-auto">
        <span class="badge bg-light text-secondary border py-2 px-3 fw-normal">
            <i class="bi bi-shield-check text-success me-1"></i> Ambiente Seguro v1.0
        </span>
    </div>
</div>

<!-- Área central del Formulario -->
<div class="my-auto w-100 py-4">
    <div class="col-12 col-sm-10 col-md-9 col-xl-8 mx-auto">
        <div class="mb-4">
            <span class="text-primary fw-bold text-uppercase small">@Resources.General.AccessToSystem</span>
            <h2 class="fw-bold text-dark mt-1 mb-2">@Resources.General.Login</h2>
            <p class="text-muted small mb-0">@Resources.General.LoginMessageCredencials</p>
        </div>

        <div class="d-flex">
            <img src="~/images/flags/@(System.Globalization.CultureInfo.CurrentUICulture.Name).png" alt="@System.Globalization.CultureInfo.CurrentUICulture.Name" width="24" height="16" />

            <form asp-controller="Culture" asp-action="SetLanguage" method="post"
                  asp-route-returnUrl="@Context.Request.Path">
                <select name="culture" onchange="this.form.submit()"
                        asp-for="@System.Globalization.CultureInfo.CurrentUICulture.Name">
                    <option value="es-MX">Español</option>
                    <option value="en">English</option>
                </select>
            </form>
        </div>

        <div id="loginAlert" class="alert alert-danger d-none py-2 small" role="alert"></div>

        <div class="mb-3">
            <label for="txtUsuario" class="form-label small fw-semibold text-secondary">@Resources.General.User</label>
            <div class="input-group">
                <span class="input-group-text bg-light text-muted border-end-0">
                    <i class="bi bi-person fs-5"></i>
                </span>
                <input type="text" class="form-control form-control-lg fs-6 border-start-0 ps-0" id="txtUsuario" placeholder="Ingresa tu usuario" autocomplete="username">
            </div>
        </div>

        <div class="mb-3">
            <div class="d-flex justify-content-between align-items-center mb-1">
                <label for="txtPassword" class="form-label small fw-semibold text-secondary mb-0">@Resources.General.Password</label>
                <a href="#" class="small text-decoration-none text-muted" data-bs-toggle="modal" data-bs-target="#forgotPasswordModal">@Resources.General.ForgotPassword</a>
            </div>
            <div class="input-group">
                <span class="input-group-text bg-light text-muted border-end-0">
                    <i class="bi bi-lock fs-5"></i>
                </span>
                <input type="password" class="form-control form-control-lg fs-6 border-start-0 ps-0" id="txtPassword" placeholder="••••••••" autocomplete="current-password">
            </div>
        </div>

        @Html.AntiForgeryToken()

        <div class="d-grid mb-4">
            <button type="button" id="btnLogin" class="btn btn-primary btn-lg fs-6 py-3 fw-semibold">
                <span id="btnSpinner" class="spinner-border spinner-border-sm me-2 d-none" role="status"></span>
                @Resources.General.Login
            </button>
        </div>
    </div>
</div>

<!-- Pie de soporte -->
<div class="text-center text-muted small pt-3 border-top w-100">
    ¿Problemas para ingresar? Contacta a Soporte de Sistemas · <strong>ext. 4520</strong>
</div>

<!-- Modal para recuperar contraseña -->
<partial name="_ForgotPasswordModal" />

@section Scripts {
    <script src="~/js/login.js"></script>
    <script src="~/js/forgot-password.js"></script>
}